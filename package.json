{
  "name": "machirun",
  "appTitle": "Machirun",
  "private": true,
  "version": "0.2.3",
  "type": "module",
  "description": "町林市バスアプリ",
  "author": {
    "name": "ANKRED",
    "url": "https://ank.red",
    "social": {
      "x": "https://x.com/_ankred",
      "misskey": "https://misskey.io/@Ankred"
    }
  },
  "homepage": "https://machirun.ank.red",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ank-red/Machirun.git"
  },
  "bugs": {
    "url": "https://github.com/Ank-red/Machirun/issues"
  },
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --tsgo && tsc --noEmit",
    "lint": "bun run lint:code && bun run lint:style",
    "lint:code": "biome lint src vite.config.ts contextCode.ts",
    "lint:style": "stylelint \"src/**/*.{css,scss,svelte}\" \"src/**/*.{css,scss,svelte}\" --fix",
    "context": "bun run contextCode.ts",
    "release:patch": "bun run release.ts patch",
    "release:minor": "bun run release.ts minor",
    "release:major": "bun run release.ts major"
  },
  "dependencies": {
    "@jsquash/avif": "^2.1.1",
    "beercss": "^5.0.3",
    "fflate": "^0.8.3",
    "material-dynamic-colors": "^1.2.0",
    "wasm-media-encoders": "^0.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@tsconfig/svelte": "^5.0.9",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "postcss-html": "^2.0.0",
    "sass": "^1.108.2",
    "stylelint": "^18.0.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "stylelint-order": "^8.1.3",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~7.0.2",
    "typescript-sub": "npm:typescript@^6.0.0",
    "vite": "^8.3.8",
    "wrangler": "^4.162.0"
  },
  "biome": {
    "linter": {
      "enabled": true,
      "rules": {
        "recommended": true,
        "style": {
          "useImportType": "error"
        },
        "correctness": {
          "noUnusedVariables": "warn",
          "noUnusedImports": "warn"
        }
      }
    },
    "overrides": [
      {
        "include": [ "*.svelte" ],
        "linter": {
          "rules": {
            "style": {
              "useConst": "off",
              "useImportType": "off"
            },
            "correctness": {
              "noUnusedVariables": "off",
              "noUnusedImports": "off"
            }
          }
        }
      }
    ]
  },
  "stylelint": {
    "extends": [
      "stylelint-config-standard-scss",
      "stylelint-config-html/svelte"
    ],
    "plugins": [
      "stylelint-order"
    ],
    "rules": {
      "order/properties-alphabetical-order": true,
      "selector-pseudo-class-no-unknown": [
        true,
        {
          "ignorePseudoClasses": [
            "global"
          ]
        }
      ]
    }
  }
}