{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Machirun Driver",
  "mainBinaryName": "machirun",
  "version": "0.1.4",
  "identifier": "city.machibayashi.machirun",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173/desktop",
    "beforeDevCommand": "bun dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Machirun Driver",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "url": "desktop.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [ "nsis", "deb", "rpm", "appimage" ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [ "Japanese" ],
        "installerHooks": "./hooks.nsh"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false,
        "files": { }
      },
      "deb": {
        "files": { },
        "desktopTemplate": "linux/machirun.desktop"
      },
      "rpm": {
        "epoch": 0,
        "files": { },
        "release": "1",
        "desktopTemplate": "linux/machirun.desktop"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
