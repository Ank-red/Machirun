{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "machirun",
  "version": "0.0.2",
  "identifier": "city.machibayashi.machirun",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173/desktop",
    "beforeDevCommand": "bun dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Machirun 車載器",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "url": "desktop.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [ "nsis", "rpm", "appimage" ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
