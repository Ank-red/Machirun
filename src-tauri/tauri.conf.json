{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Machirun Driver",
  "mainBinaryName": "machirun",
  "version": "0.4.6",
  "identifier": "city.machibayashi.machirun",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173/driver.html",
    "beforeDevCommand": "bun dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Machirun Driver",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "url": "driver.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Japanese"
        ],
        "installerHooks": "./hooks.nsh"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false,
        "files": {}
      },
      "deb": {
        "files": {},
        "desktopTemplate": "linux/machirun.desktop"
      },
      "rpm": {
        "epoch": 0,
        "files": {},
        "release": "1",
        "desktopTemplate": "linux/machirun.desktop"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGN0JBMkU1ODQ2MDJEMDYKUldRR0xXQ0U1YUo3cjZsRThjZ2Jzd1RnZENaakhmTHQ5cFdnOTdZek84TXZ1aUw5cGRheWx0bDcK",
      "endpoints": [
        "https://github.com/Ank-red/Machirun/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
